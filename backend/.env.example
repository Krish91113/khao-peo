NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/khao-peeo
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CLIENT_URL=http://localhost:5173

# Optional Gmail SMTP. Keep credentials backend-only and never commit them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
# Backward-compatible alias accepted by the mailer:
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Khao Peeo POS

LOG_LEVEL=info
REDIS_URL=

