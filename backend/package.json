{
  "name": "khao-peeo-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for KHAO PEEO (MERN conversion)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "dev:legacy": "nodemon server.js",
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run build",
    "start": "node dist/app/server.js",
    "start:legacy": "node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir src/**/tests/unit",
    "test:integration": "vitest run --dir src/**/tests/integration",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run typecheck && npm run lint && npm run test",
    "seed:tables": "node scripts/seedTables.js",
    "create-superadmin": "node createSuperAdmin.js"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.7",
    "typescript": "~5.8.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
